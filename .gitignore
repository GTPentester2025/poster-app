node_modules/

# The RUNTIME DB (data/poster-app.sqlite) is git-ignored: the app writes to it
# constantly, so tracking it makes every `git pull` conflict on a locally-
# modified binary. The shipped poster library ships instead as a read-only SEED
# (data/poster-seed.sqlite, tracked) that the app never writes and copies into
# place on first run. Image assets (image-library/assets/) stay tracked — new
# files, never conflicting. Run `npm run reseed` to refresh runtime from seed.
data/poster-app.sqlite
data/*.sqlite-shm
data/*.sqlite-wal
data/session-token

# secrets / local
data/secrets.json
.env
.env.*
*.log

.playwright-mcp/
